---
import CurveViz from "./CurveViz.astro";
---

<section class="relative isolate overflow-hidden">
  <div
    class="absolute inset-0 -z-10"
    style="background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in oklch, var(--hero-via) 80%, var(--hero-from)) 0%, var(--hero-from) 55%, var(--hero-to) 100%);"
  ></div>
  <div class="hero-grid absolute inset-0 -z-10 opacity-70"></div>
  <div class="hero-glow absolute inset-x-0 top-[-10%] -z-10 h-[60rem]"></div>

  <div class="container-x section-tight pt-16 md:pt-24 lg:pt-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr]">
      <div class="reveal">
        <span class="chip">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Educational · Research · Rust 2021</span>
        </span>

        <h1 class="h-display mt-6 text-balance text-[clamp(2.5rem,6vw,4.5rem)] text-white">
          secp256k1, <span class="text-[color:var(--color-brand-300)]">decomposed</span>
          <br class="hidden sm:block" />
          into 512 parallel paths.
        </h1>

        <p class="mt-6 max-w-xl text-pretty text-[1.05rem] leading-relaxed text-white/70 md:text-[1.12rem]">
          A research-grade Rust engine that finds secp256k1 scalars with
          <span class="text-white">sub-second</span> throughput. Powered by 512-variant range-splitting,
          Montgomery batch inversion, and a Radix16 fixed-base table — wired together with zero unsafe in the hot path.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#install" class="btn btn-primary !bg-white !text-black hover:!bg-white/90">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Install
          </a>
          <a
            href="https://github.com/sachncs/find"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost !border-white/15 !bg-white/5 !text-white hover:!bg-white/10"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.06c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.71 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.44-2.7 5.42-5.26 5.7.41.36.78 1.07.78 2.16v3.21c0 .31.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
            </svg>
            Star on GitHub
          </a>
          <a
            href="https://crates.io/crates/find"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost !border-white/15 !bg-transparent !text-white/80 hover:!text-white"
          >
            crates.io
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8"/>
            </svg>
          </a>
        </div>

        <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-8 text-white/80">
          <div>
            <dt class="text-[0.7rem] uppercase tracking-[0.18em] text-white/50">Throughput</dt>
            <dd class="mt-1.5 font-display text-[1.7rem] tracking-[-0.04em] text-white">10⁶<span class="text-[0.6em] text-white/50">/s</span></dd>
          </div>
          <div>
            <dt class="text-[0.7rem] uppercase tracking-[0.18em] text-white/50">Hot-path unsafe</dt>
            <dd class="mt-1.5 font-display text-[1.7rem] tracking-[-0.04em] text-white">1<span class="text-[0.6em] text-white/50"> block</span></dd>
          </div>
          <div>
            <dt class="text-[0.7rem] uppercase tracking-[0.18em] text-white/50">Variants</dt>
            <dd class="mt-1.5 font-display text-[1.7rem] tracking-[-0.04em] text-white">512</dd>
          </div>
        </dl>
      </div>

      <div class="relative reveal" style="animation-delay: 120ms">
        <div class="relative">
          <CurveViz />
        </div>
      </div>
    </div>

    <div class="mt-20 grid grid-cols-2 items-center gap-x-8 gap-y-4 border-t border-white/10 pt-8 text-[0.78rem] uppercase tracking-[0.18em] text-white/40 md:grid-cols-5">
      <span class="flex items-center gap-2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Pure Rust 2021
      </span>
      <span class="flex items-center gap-2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        MSRV 1.81
      </span>
      <span class="flex items-center gap-2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Linux · macOS · Windows
      </span>
      <span class="flex items-center gap-2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        x86_64 · aarch64
      </span>
      <span class="flex items-center gap-2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        MIT licensed
      </span>
    </div>
  </div>
</section>