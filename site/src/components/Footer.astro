---
import Logo from "./Logo.astro";

const groups = [
  {
    title: "Product",
    links: [
      { label: "Overview", href: "#overview" },
      { label: "Features", href: "#features" },
      { label: "Performance", href: "#performance" },
      { label: "Two modes", href: "#modes" },
    ],
  },
  {
    title: "Engineering",
    links: [
      { label: "Architecture", href: "#architecture" },
      { label: "Verification", href: "#verify" },
      { label: "API docs (docs.rs)", href: "https://docs.rs/find", external: true },
      { label: "Source on GitHub", href: "https://github.com/sachncs/find", external: true },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "crates.io", href: "https://crates.io/crates/find", external: true },
      { label: "Changelog", href: "https://github.com/sachncs/find/blob/master/CHANGELOG.md", external: true },
      { label: "Roadmap", href: "https://github.com/sachncs/find/blob/master/docs/roadmap.md", external: true },
      { label: "Disclaimer", href: "https://github.com/sachncs/find/blob/master/DISCLAIMER.md", external: true },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "MIT License", href: "https://github.com/sachncs/find/blob/master/LICENSE-MIT", external: true },
      { label: "Security policy", href: "https://github.com/sachncs/find/blob/master/SECURITY.md", external: true },
      { label: "Code of Conduct", href: "https://github.com/sachncs/find/blob/master/CODE_OF_CONDUCT.md", external: true },
      { label: "Contributing", href: "https://github.com/sachncs/find/blob/master/CONTRIBUTING.md", external: true },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--line)] bg-[var(--bg)]">
  <div class="container-x py-16">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <Logo size={32} />
        <p class="mt-5 max-w-sm text-[0.92rem] leading-relaxed text-[var(--fg-muted)]">
          A research-grade Rust engine for secp256k1 scalar discovery.
          Educational and pedagogical only — never deploy against live keys.
        </p>

        <div class="mt-7 flex items-center gap-2">
          <a
            href="https://github.com/sachncs/find"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--line)] text-[var(--fg-muted)] transition hover:border-[var(--line-strong)] hover:text-[var(--fg)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.06c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.71 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.44-2.7 5.42-5.26 5.7.41.36.78 1.07.78 2.16v3.21c0 .31.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
            </svg>
          </a>
          <a
            href="https://crates.io/crates/find"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="crates.io"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--line)] text-[var(--fg-muted)] transition hover:border-[var(--line-strong)] hover:text-[var(--fg)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M2 4h20v3H2zm0 5h20v3H7v3l-5-3zm0 8h20v3H2z"/>
            </svg>
          </a>
          <a
            href="https://docs.rs/find"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="docs.rs"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--line)] text-[var(--fg-muted)] transition hover:border-[var(--line-strong)] hover:text-[var(--fg)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
        {groups.map((g) => (
          <div>
            <h4 class="text-[0.7rem] font-medium uppercase tracking-[0.18em] text-[var(--fg-subtle)]">
              {g.title}
            </h4>
            <ul class="mt-4 space-y-2.5 text-[0.9rem]">
              {g.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.external ? "_blank" : undefined}
                    rel={l.external ? "noopener noreferrer" : undefined}
                    class="text-[var(--fg-muted)] hover:text-[var(--fg)]"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-[var(--line)] pt-6 text-[0.78rem] text-[var(--fg-subtle)] md:flex-row md:items-center">
      <p>
        © {year} Sachin · MIT License.
        <span class="ml-1 text-[var(--fg-muted)]">Educational and research use only.</span>
      </p>
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1.5">
          <span class="status-dot"></span>
          <span class="font-mono text-[0.72rem]">all systems nominal</span>
        </span>
        <span class="text-[var(--line-strong)]">·</span>
        <span class="font-mono text-[0.72rem]">v0.1.6 · MSRV 1.81</span>
      </div>
    </div>
  </div>
</footer>