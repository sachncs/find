---
const modes = [
  {
    tag: "Default",
    title: "Pubkey mode",
    desc:
      "Search the full scalar space for an X-coordinate match against a SEC1 compressed public key. The traditional variant-keyed sweep used by the discovery engine.",
    code: `find --pubkey 0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798`,
    code2: `find --pubkey 0279be66... \\
     --cache-points \\
     --batch-size 64 \\
     --variants 256`,
    accent: "var(--color-brand-500)",
    href: "https://github.com/sachncs/find/blob/master/docs/adr/0001-multi-variant-search.md",
  },
  {
    tag: "Address mode",
    title: "Hash40-targeted discovery",
    desc:
      "Search a user-specified scalar range [from, to] for the scalar behind a Bitcoin mainnet P2PKH/P2SH address. Hash40 compare keeps the inner loop cheap.",
    code: `find --address 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa \\
     --from 1 --to 100000000`,
    code2: `find --address 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa \\
     --from 0x1 --to 0x5F5E100`,
    accent: "var(--color-accent-500)",
    href: "https://github.com/sachncs/find/blob/master/docs/adr/0011-address-discovery.md",
  },
];
---

<section id="modes" class="section">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow justify-center">Two input modes</span>
      <h2 class="h-section mt-3 text-[clamp(2rem,4vw,3.25rem)] text-[var(--fg)]">
        Pubkey sweep, or address-keyed range search.
      </h2>
      <p class="mt-5 text-[1.02rem] leading-relaxed text-[var(--fg-muted)]">
        Same engine, two entry points. Config::new vs Config::new_address_mode select the surface —
        the hot loop stays identical and the verification layers apply to both.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      {modes.map((m) => (
        <article class="card relative overflow-hidden p-7">
          <div
            class="absolute inset-x-0 top-0 h-px"
            style={`background:linear-gradient(90deg, transparent, ${m.accent}, transparent); opacity:0.5;`}
          ></div>
          <div class="flex items-center justify-between">
            <span
              class="chip"
              style={`color:${m.accent}; border-color:${m.accent}30; background:${m.accent}10;`}
            >
              {m.tag}
            </span>
            <a
              href={m.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[0.78rem] text-[var(--fg-subtle)] hover:text-[var(--fg)]"
            >
              ADR ↗
            </a>
          </div>
          <h3 class="mt-4 font-display text-[1.4rem] tracking-[-0.03em] text-[var(--fg)]">
            {m.title}
          </h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-[var(--fg-muted)]">{m.desc}</p>

          <div class="mt-6 overflow-hidden rounded-xl border border-[var(--line)] bg-[var(--bg-sunken)]">
            <div class="flex items-center gap-2 border-b border-[var(--line)] bg-[var(--bg-elev)] px-4 py-2">
              <span class="h-2 w-2 rounded-full bg-[color:var(--color-brand-500)]/60"></span>
              <span class="font-mono text-[0.7rem] text-[var(--fg-subtle)]">terminal</span>
            </div>
            <pre class="overflow-x-auto p-4 font-mono text-[0.82rem] leading-relaxed text-[var(--fg)]"><code>{m.code}</code></pre>
          </div>

          <div class="mt-3 overflow-hidden rounded-xl border border-[var(--line)] bg-[var(--bg-sunken)]/60">
            <pre class="overflow-x-auto p-4 font-mono text-[0.82rem] leading-relaxed text-[var(--fg-muted)]"><code>{m.code2}</code></pre>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[0.78rem] uppercase tracking-[0.18em] text-[var(--fg-subtle)]">
      <span>--pubkey &lt;hex&gt;</span>
      <span class="text-[var(--line-strong)]">·</span>
      <span>--address &lt;base58&gt;</span>
      <span class="text-[var(--line-strong)]">·</span>
      <span>--from &lt;int|hex&gt;</span>
      <span class="text-[var(--line-strong)]">·</span>
      <span>--to &lt;int|hex&gt;</span>
      <span class="text-[var(--line-strong)]">·</span>
      <span>--batch-size 1..=256</span>
      <span class="text-[var(--line-strong)]">·</span>
      <span>--variants 1..=512</span>
      <span class="text-[var(--line-strong)]">·</span>
      <span>--cache-points</span>
    </div>
  </div>
</section>